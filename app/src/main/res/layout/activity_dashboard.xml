<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#000000"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/guide_intro"
                android:textColor="#333333" />

            <!-- Shown only when Layzee was found dead without the user's Stop. -->
            <TextView
                android:id="@+id/died_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFB300"
                android:padding="8dp"
                android:text="@string/died_hint"
                android:textColor="#000000"
                android:visibility="gone" />

            <TextView
                android:id="@+id/step_accessibility"
                style="@style/StepTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_accessibility_why"
                android:textColor="#333333" />
            <Button
                android:id="@+id/open_accessibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_accessibility_action" />

            <TextView
                android:id="@+id/step_overlay"
                style="@style/StepTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_overlay_why"
                android:textColor="#333333" />
            <Button
                android:id="@+id/open_overlay_permission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_overlay_action" />

            <TextView
                android:id="@+id/step_camera"
                style="@style/StepTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_camera_why"
                android:textColor="#333333" />
            <Button
                android:id="@+id/request_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_camera_action" />

            <TextView
                android:id="@+id/step_battery"
                style="@style/StepTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_battery_why"
                android:textColor="#333333" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/open_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_battery_action" />
                <Button
                    android:id="@+id/open_app_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_app_info_action" />
            </LinearLayout>
            <CheckBox
                android:id="@+id/battery_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_battery_done"
                android:textColor="#000000" />

            <Button
                android:id="@+id/toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/test_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/test_stop_first"
                android:textColor="#B00020"
                android:visibility="gone" />
            <Button
                android:id="@+id/open_test"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_test" />
        </LinearLayout>
    </ScrollView>

    <!-- Pinch test: camera preview with landmarks on top, the live state, and a list below that a pinch scrolls
         (the flick starts at 65% of the screen height, inside the list). Back or Tutup closes it. -->
    <LinearLayout
        android:id="@+id/test_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <com.layzee.LandmarkView
            android:id="@+id/landmark_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/test_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/test_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/test_close" />
        </LinearLayout>

        <ListView
            android:id="@+id/playground"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000"
            android:divider="@null" />
    </LinearLayout>
</FrameLayout>
