<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#000000"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/guide_intro"
                android:textColor="#333333" />

            <!-- Shown only when Layzee was found dead without the user's Stop. -->
            <TextView
                android:id="@+id/died_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFB300"
                android:padding="8dp"
                android:text="@string/died_hint"
                android:textColor="#000000"
                android:visibility="gone" />

            <TextView
                android:id="@+id/step_accessibility"
                style="@style/StepTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_accessibility_why"
                android:textColor="#333333" />
            <Button
                android:id="@+id/open_accessibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_accessibility_action" />

            <TextView
                android:id="@+id/step_overlay"
                style="@style/StepTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_overlay_why"
                android:textColor="#333333" />
            <Button
                android:id="@+id/open_overlay_permission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_overlay_action" />

            <TextView
                android:id="@+id/step_camera"
                style="@style/StepTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_camera_why"
                android:textColor="#333333" />
            <Button
                android:id="@+id/request_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_camera_action" />

            <TextView
                android:id="@+id/step_battery"
                style="@style/StepTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_battery_why"
                android:textColor="#333333" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/open_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_battery_action" />
                <Button
                    android:id="@+id/open_app_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_app_info_action" />
            </LinearLayout>
            <CheckBox
                android:id="@+id/battery_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_battery_done"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/step_calibration"
                style="@style/StepTitle" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_calibration_why"
                android:textColor="#333333" />
            <TextView
                android:id="@+id/calibration_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calibration_stop_first"
                android:textColor="#B00020"
                android:visibility="gone" />
            <Button
                android:id="@+id/open_calibration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/StepTitle"
                android:text="@string/sensitivity_title" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sensitivity_why"
                android:textColor="#333333" />
            <SeekBar
                android:id="@+id/sensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sensitivity_tight"
                    android:textColor="#333333" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sensitivity_loose"
                    android:textColor="#333333" />
            </LinearLayout>
            <TextView
                android:id="@+id/sensitivity_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sensitivity_next_start"
                android:textColor="#B00020"
                android:visibility="gone" />

            <TextView
                style="@style/StepTitle"
                android:text="@string/dot_title" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dot_why"
                android:textColor="#333333" />
            <SeekBar
                android:id="@+id/dot_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dot_small"
                    android:textColor="#333333" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dot_large"
                    android:textColor="#333333" />
            </LinearLayout>

            <TextView
                style="@style/StepTitle"
                android:text="@string/speed_title" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/speed_why"
                android:textColor="#333333" />
            <SeekBar
                android:id="@+id/swipe_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/speed_slow"
                    android:textColor="#333333" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/speed_fast"
                    android:textColor="#333333" />
            </LinearLayout>

            <Button
                android:id="@+id/toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp" />

            <Button
                android:id="@+id/open_playground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_playground" />
        </LinearLayout>
    </ScrollView>

    <!-- Calibration: camera preview with landmarks, the current ask, and restart/close. Back closes it. -->
    <LinearLayout
        android:id="@+id/calibration_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <com.layzee.LandmarkView
            android:id="@+id/landmark_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000" />

        <TextView
            android:id="@+id/calibration_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/calibration_problem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B00020" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/calibration_restart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calibration_restart" />
            <Button
                android:id="@+id/calibration_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calibration_close" />
        </LinearLayout>
    </LinearLayout>

    <!-- Playground: a plain scrollable list, no numbers shown. Opened from the guide; Back closes it. -->
    <ListView
        android:id="@+id/playground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:divider="@null"
        android:visibility="gone" />
</FrameLayout>
