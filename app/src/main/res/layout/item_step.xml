<?xml version="1.0" encoding="utf-8"?>
<!-- One permission step: status icon, title, a fold-out reason, and shortcut buttons to the system setting. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LayzeeCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/step_icon"
            android:layout_width="28dp"
            android:layout_height="28dp" />
        <TextView
            android:id="@+id/step_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/step_why_toggle"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:textAllCaps="false"
            android:text="@string/why"
            android:textColor="@color/accent"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/step_why"
        style="@style/LayzeeBody"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/step_action"
            style="@style/LayzeeButtonPrimary" />
        <Button
            android:id="@+id/step_action2"
            style="@style/LayzeeButtonSecondary"
            android:layout_marginStart="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/step_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/step_battery_done"
        android:textColor="@color/text_primary"
        android:visibility="gone" />
</LinearLayout>
